scheduler:
  timezone: Asia/Shanghai
  crawl_scope: soe_and_industry
  default_interval_minutes: 60
  per_site_schedule_enabled: false
  round_robin_interval_minutes: 8
  per_site_cycle_minutes: null
  run_on_start: false
  max_workers: 2
  default_min_delay_seconds: 2
  max_retries: 3
  alert_consecutive_failures: 3
  alert_failure_rate_threshold: 0.5
  daily_sync_enabled: false
  daily_bim_sync_enabled: false
  bim_backfill_labels_enabled: false
  bim_brief_enabled: false
  daily_agri_sync_enabled: true
  daily_agri_sync_cron: 0 4 * * *
  daily_agri_sync_stagger_seconds: 30
  daily_agri_sync_max_items: 30
  daily_agri_sync_backfill_limit: 200
  daily_agri_sync_insights_enabled: true
  daily_biz_clue_sync_enabled: true
  daily_biz_clue_sync_cron: 30 6 * * *
  daily_biz_clue_brief_cron: 30 8 * * *
  daily_biz_clue_sync_stagger_seconds: 30
  daily_biz_clue_sync_max_items: 30
  daily_biz_clue_sync_analysis_enabled: true
  daily_biz_clue_brief_enabled: true
  daily_stock_news_sync_enabled: true
  daily_stock_news_sync_cron: 0 6 * * *
  daily_stock_news_sync_insights_enabled: true
  daily_policy_sync_enabled: true
  agri_site_ids:
  - 中国建筑集团有限公司_云筑网
  - crec_bidding
  - dlzb_power
  - 中国铁道建筑集团有限公司_物资采购网
  - 中国交通建设集团有限公司_供应链管理信息系统
  - 中国电力建设集团有限公司_公共资源交易服务平台
  - 中国能源建设集团有限公司_电子采购平台
jobs:
- site_id: ccgp_national
  trigger: interval
  minutes: 30
  enabled: true
- site_id: ccgp_北京市
  trigger: interval
  minutes: 60
  enabled: true
- site_id: ccgp_上海市
  trigger: interval
  minutes: 60
  enabled: true
- site_id: ccgp_广东省
  trigger: interval
  minutes: 60
  enabled: true
