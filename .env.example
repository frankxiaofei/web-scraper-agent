# Chromium 可执行文件（二选一，PLAYWRIGHT_CHROMIUM_EXECUTABLE 优先）
# macOS arm64 示例（项目 docs/ 下已附带 Chrome for Testing）：
CHROMIUM_EXECUTABLE_PATH=docs/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=docs/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing

# 若使用 Playwright 标准 ms-playwright 目录结构，可设置浏览器根目录（无需 executable_path）：
# PLAYWRIGHT_BROWSERS_PATH=docs/ms-playwright

# ── Docker 拉镜像代理（influxdb/postgres 等官方 tag）────────────────
# httpx/爬虫与 Docker 共用变量名；Docker Desktop 拉镜像需在 Settings → Resources → Proxies
# 填写与下方相同的 httpProxy/httpsProxy（shell 里的 HTTP_PROXY 不会自动传给 docker pull）。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# 世舶招投标 REST API（密钥只写入本地 .env，不要提交真实值）
# GOV_BID_API_KEY=
# GOV_BID_BASE_URL=https://gate.gov-bid.com/outer-gateway
# NO_PROXY=api.deepseek.com,localhost,127.0.0.1,reg.hdec.com,.hdec.com
# ALL_PROXY=socks5://127.0.0.1:7890
# compose influxdb 镜像（默认官方 tag；可先 make pull-influx）
# INFLUXDB_IMAGE=influxdb:2.7
# pull-influx 直连失败时的镜像加速前缀（DaoCloud 示例）
# INFLUXDB_MIRROR=docker.m.daocloud.io/library/influxdb:2.7

# ── Commercial 订阅 / 认证 / 计量（Phase C0）────────────────────
# 默认 false：不影响现有自托管 MVP；SaaS 部署时设为 true
BILLING_ENABLED=false
# JWT 签名密钥（生产务必更换；生成: openssl rand -hex 32）
# JWT_SECRET=
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TTL_MINUTES=15
# JWT_SECRET_PREVIOUS=

# ── 行业洞察 Phase 1 MDM ─────────────────────────────────────
# Phase 0 默认 false；启用后 Pipeline 异步 enrichment（需 PostGIS + mdm schema）
INDUSTRY_ENRICHMENT_ENABLED=false
INDUSTRY_INSIGHTS_CACHE_TTL_SECONDS=60

# ── Phase 2 Neo4j 图谱 ─────────────────────────────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=industry_scraper_pass
# NEO4J_SYNC_ENABLED=false

# ── Commercial C2 Stripe 支付 ───────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...

# ── Phase 3 全球扩展 ─────────────────────────────────────────
# SAM_API_KEY=
# PANJIVA_API_KEY=

# ── Phase 2 存储层 ──────────────────────────────────────────

# PostgreSQL（docker compose 默认账号，见 docker/docker-compose.yml）
DATABASE_URL=postgresql://scraper:scraper_pass@localhost:5433/bid_scraper

# Redis 去重（可选；未设置时使用内存 + JSONL）
REDIS_URL=redis://localhost:6380/0

# Redis 去重 SET 过期时间（秒），0 = 永不过期
REDIS_DEDUP_TTL_SECONDS=0

# JSONL 落盘目录（默认 data/）
# DATA_DIR=data

# ── Phase 4+ MongoDB 存储 ────────────────────────────────────

# MongoDB（docker compose 默认端口 27018，见 docker/docker-compose.yml）
MONGODB_URI=mongodb://localhost:27018/bid_scraper
MONGODB_DB=bid_scraper
MONGODB_COLLECTION=bid_notices

# 智能爬取 LLM 语义决策（可选；默认 false，使用规则引擎）
# 勿将真实 API Key 提交到 git，仅写入本地 .env
INTELLIGENT_CRAWL_LLM=false
OPENAI_API_KEY=sk-xxx
# Hermes Agent 默认 LLM（三选一，勿留 sk-xxx 占位符）：
# OPENROUTER_API_KEY=sk-or-v1-...          # hermes model.provider=openrouter
# DEEPSEEK_API_KEY=sk-...                  # hermes model.provider=deepseek
# 或使用 OpenAI 兼容接口（DeepSeek 等）：
# DeepSeek 示例（OpenAI 兼容接口；base_url 不含 /v1，客户端自动拼接 /v1/chat/completions）
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-flash
# 也支持 LLM_BASE_URL / LLM_MODEL 别名
# OpenAI 示例
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini
#
# 信息抽取专用小模型（与对话/Agent 模型分离；未设置时回退 OPENAI_MODEL / LLM_MODEL）
# 适用：公告字段抽取、BIM/农业分类等结构化 JSON 输出，高吞吐、低成本
# LLM_EXTRACTION_MODEL=deepseek-v4-flash
# 也支持 EXTRACTION_MODEL 别名；示例：
# LLM_EXTRACTION_MODEL=qwen-turbo          # 通义千问（需对应 base_url + key）
# LLM_EXTRACTION_MODEL=glm-4-flash         # 智谱（需对应 base_url + key）
# LLM_EXTRACTION_MODEL=llama3.2:3b          # 本地 Ollama（OPENAI_BASE_URL=http://127.0.0.1:11434/v1）

# [已废弃] 请改用 INTELLIGENT_CRAWL_LLM
RECURSIVE_CRAWL_LLM=false

# 关键信息 LLM 提取（可选；默认 false，使用正则规则）
KEY_INFO_LLM=false

# BIM 相关招标 LLM 分类（默认 true；需 OPENAI_API_KEY，爬取/同步时自动判定）
BIM_CLASSIFY_LLM=true

# 商机洞察招标 LLM 分类（默认 false，使用关键词；8091 专题可选增强）
# AGRI_CLASSIFY_LLM=true

# ── Hermes Agent（对话 / 调度 crawl dispatch）────────────────────
# scheduler 委托 Gateway crawl dispatch 根 URL（本地 screen：:8080）
HERMES_AGENT_URL=http://127.0.0.1:8080
# /hermes 对话委托 API Server 根 URL（:8642，POST /v1/runs）；未设置时由 HERMES_AGENT_URL 推导 :8642
HERMES_AGENT_CHAT_URL=http://127.0.0.1:8642
# Gateway / API Server HTTP 超时 / 重试（秒）
# HERMES_AGENT_TIMEOUT=300
# HERMES_AGENT_RETRIES=3
# Hermes API Server Bearer Token（与 hermes-agent 的 API_SERVER_KEY 一致）
# hermes-agent 启用 API_SERVER_ENABLED 后 /v1/runs 强制鉴权；未配置或 key 不一致会 HTTP 401
# 生成新 key：openssl rand -hex 32
# 同步方式（任选其一）：
#   1) 将同一 key 写入本文件 HERMES_AGENT_API_KEY 与 hermes HERMES_HOME/.env 的 API_SERVER_KEY
#   2) 在 web_scraper 仓库运行 make start-hermes-agent（bootstrap 会从本 .env 镜像到 data/hermes-agent/.env）
# 修改 key 后无需重启 Web UI（客户端每次请求重读 .env）；hermes-agent 需 restart-hermes-agent
# HERMES_AGENT_API_KEY=
# hermes-agent crawl toolset 回调 web_scraper API（在 hermes-agent 侧配置，非本文件变量）
# WEB_SCRAPER_BASE_URL=http://127.0.0.1:8090
# Kimi WebBridge daemon（hermes-agent 侧，默认 127.0.0.1:10086）
# KIMI_WEBBRIDGE_URL=http://127.0.0.1:10086

# Hermes 对话 Agent 单次请求最大 LLM 推理轮次（默认 100）
# CRAWL_AGENT_MAX_ROUNDS=100
# 检测到全量爬取意图时的推理轮次上限（默认 100）
# CRAWL_AGENT_MAX_ROUNDS_FULL=100

# ── HTTP API 抓取代理（bid.powerchina.cn 等 IP 封锁站）────────────────
# 本机不可直连时配置代理/VPN；httpx 会用于 skill_http_fetch_list / RuleExecutor API 路径
# 代理变量见上文「Docker 拉镜像代理」

# ── 股票专题数据源（8092）────────────────────────────────────
# 行情/板块数据提供方：akshare（默认）| tushare（需 token，暂未实现）
STOCK_DATA_PROVIDER=akshare
# Tushare Pro Token（可选，STOCK_DATA_PROVIDER=tushare 时使用）
# TUSHARE_TOKEN=
# 额外 RSS 源 URL，逗号分隔（与 config/stock_watch.yaml 中 RSS 源叠加）
# STOCK_NEWS_RSS=https://feed.eastmoney.com/rss/cjxw.xml
# 新闻源，逗号分隔：akshare,mock,bid_notices,xinhua_finance,eastmoney_roll
# akshare=东方财富全球财经快讯；mock=演示；bid_notices=招采库关键词
STOCK_NEWS_SOURCES=akshare,bid_notices
# 政府政策源（8092 十五五分析），逗号分隔，见 config/policy_sources.yaml
# gov_cn,ndrc,miit,most,moa,mee,sasac,mofcom,mock
POLICY_NEWS_SOURCES=gov_cn,ndrc,miit,most,moa,mee,sasac,mofcom
# 抓取失败时是否回退 mock 演示数据（生产环境建议 false）
POLICY_USE_MOCK_WHEN_EMPTY=false
STOCK_USE_MOCK_WHEN_EMPTY=false

# ── K 线时序存储（InfluxDB 2.x）──────────────────────────────
# docker compose 默认见 docker/docker-compose.yml influxdb 服务
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=web_scraper-admin-token-change-me
INFLUXDB_ORG=web_scraper
INFLUXDB_BUCKET=stock_ts
# 存储后端，逗号分隔：influxdb | mongodb | jsonl；默认 influxdb 主存，未配置时回退 Mongo/JSONL
KLINE_STORAGE=influxdb
# 双写示例：KLINE_STORAGE=influxdb,mongodb

# ── 个股公司资料本地存储（8092）──────────────────────────────
# 存储后端：mongodb（默认）| jsonl | mongodb,jsonl；Mongo 不可用时自动降级 JSONL
STOCK_COMPANY_STORAGE=mongodb
# 本地缓存有效期（小时），过期后 GET 会重新拉取 AKShare 并写回
STOCK_COMPANY_CACHE_HOURS=24

# 是否启用港股检索、K 线、公司详情（默认 true）
STOCK_HK_ENABLED=true
# 是否启用美股检索、K 线、公司详情（默认 true）
STOCK_US_ENABLED=true

# ── Phase 4 运维 ──────────────────────────────────────────

# 告警 Webhook（钉钉/飞书等；未设置则仅写日志）
# ALERT_WEBHOOK_URL=https://example.com/webhook

# ── 通知渠道（定时任务 / 简报推送）────────────────────────────
# 飞书群机器人 Webhook（未设置则跳过，不报错）
FEISHU_WEBHOOK_URL=
# 可选：飞书机器人「签名校验」密钥
FEISHU_WEBHOOK_SECRET=
# 钉钉群机器人 Webhook（可选加签 DINGTALK_SECRET）
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
# 企业微信群机器人 Webhook
WECHAT_WEBHOOK_URL=
# SMTP 邮件（任务级可覆盖收件人）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
NOTIFICATION_EMAIL_TO=
# 短信通用 HTTP API（需自行对接第三方网关）
SMS_PROVIDER=http
SMS_API_URL=
SMS_API_KEY=
NOTIFICATION_SMS_TO=
# 是否启用 BIM 日报推送（scheduler 定时 + CLI）
BIM_BRIEF_ENABLED=true
# 每日推送 cron（五段式：分 时 日 月 周；默认 08:00，在 daily_bim_sync 03:00 之后）
BIM_BRIEF_CRON=0 8 * * *
# Web 详情页基址（简报「查看详情」链接）
PUBLIC_BASE_URL=http://127.0.0.1:8090
